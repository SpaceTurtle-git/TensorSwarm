# Normalise text in the repository, but check scripts out with the line endings their
# interpreter needs, whatever the cloner's core.autocrlf setting is.
* text=auto

# Windows: cmd.exe misparses .cmd files with LF line endings.
*.cmd   text eol=crlf
*.bat   text eol=crlf
*.ps1   text eol=crlf
*.psm1  text eol=crlf

# Linux / Docker: bash fails on CRLF ("$'\r': command not found").
*.sh    text eol=lf
Dockerfile text eol=lf
*.yml   text eol=lf

*.pdf   binary
*.png   binary
*.svg   text

# Pre-built dashboard: generated by `npm run build:static`; hide it from diffs and language stats.
master/dashboard/** linguist-generated=true -diff
